APP_NAME="DreamStill"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Local dev: mysql (matches production MariaDB 10.6). sqlite acceptable for quick spikes.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dreamstill
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (production: Plesk mail / SMTP for dreamstill.ca) -------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@dreamstill.ca"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sorty API --------------------------------------------------------------
# Sanctum token expiry in minutes (null = no expiry; prod uses 43200 = 30 days)
SANCTUM_TOKEN_EXPIRATION=43200
# Per-user daily AI analysis quota (cost guard)
SORTY_ANALYZE_DAILY_QUOTA=50
# Decision engine version tag stamped onto every analysis record
SORTY_DECISION_TREE_VERSION=1.0

# --- Azure OpenAI (vision analysis + chatbot; v1 API) ------------------------
# Endpoint of the Azure AI Services resource, e.g. https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Single multimodal deployment used for both vision and chat (gpt-5-mini).
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Optional per-role overrides:
# AZURE_OPENAI_VISION_DEPLOYMENT=
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_VISION_REASONING=low
# AZURE_OPENAI_CHAT_REASONING=minimal

# --- Azure ML custom model endpoint (Phase 9 — leave empty until deployed) ---
AZURE_ML_SCORE_URI=
AZURE_ML_SCORE_KEY=

# --- Media / CDN (Azure Blob) -------------------------------------------------
# 'local' = private disk served via API routes; 'azure' = public CDN URLs.
SORTY_MEDIA_DISK=azure
AZURE_STORAGE_NAME=dreamstill
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=cdn
# Swap to https://cdn.dreamstill.ca later without touching code:
AZURE_STORAGE_URL=https://dreamstill.blob.core.windows.net/cdn

# --- Maps -------------------------------------------------------------------
# Server-side key for geocoding partner locations (restricted, never shipped to app)
GOOGLE_MAPS_SERVER_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
